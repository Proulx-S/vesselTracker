# Regenerable intermediates are not version-controlled ...
*.mat
# ... EXCEPT drawVesselCenterCache/: the hand-clicked vessel centers from drawVesselCenter.m --
# irreplaceable human judgment, not regenerable by re-running an algorithm.
!drawVesselCenterCache/*.mat

# Outputs regenerated by doIt.m
figures/
qaMovies/
fitVesselTimeSeriesDiagMovies/
fitVesselPatchTimeSeriesCache/

# Throwaway scratch (probe scripts, run logs). scratch/.gitkeep is tracked so the folder always exists.
scratch/*
!scratch/.gitkeep
tmp/

# Claude Code worktrees (each is its own nested checkout)
.claude/worktrees/

.DS_Store
